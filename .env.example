# Public site URL used for canonical links and the sitemap.
# Vercel preview can keep its own URL. Production should be https://yellowmusicunited.se
NEXT_PUBLIC_SITE_URL=https://yellowmusicunited.se

# Public Sanity project. These values are not secrets. They are also the defaults in src/sanity/env.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=vjv9ko18
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# Do not put a write token in this file. Seed with:
#   SANITY_API_TOKEN=... npm run sanity:seed
SANITY_REVALIDATE_SECRET=

# Optional viewer token if you later turn on draft previews.
SANITY_API_READ_TOKEN=
